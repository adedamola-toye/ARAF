# ---------------------------------------------------------------------------
# AltBank Retail Asset Factory - environment template
# Copy to .env (development) and adjust. Never commit real secrets.
# ---------------------------------------------------------------------------

# development | test | production
APP_ENV=development
# Public base URL used in emailed deep links
APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://wakeel:wakeel@localhost:5432/wakeel_dev
# Used by `npm test` (database is dropped/recreated by the test setup)
TEST_DATABASE_URL=postgres://wakeel:wakeel@localhost:5432/wakeel_test

# 32-byte keys, base64 encoded. Generate with: openssl rand -base64 32
# Field-level encryption for BVN / TIN
FIELD_ENCRYPTION_KEY=ZGV2LW9ubHktZmllbGQta2V5LWNoYW5nZS1tZS0zMmI=
# HMAC key for OTP hashing, identifier hashing and signed document URLs
APP_HMAC_KEY=ZGV2LW9ubHktaG1hYy1rZXktY2hhbmdlLW1lLTMyYnk=

# Sessions / OTP
SESSION_IDLE_SECONDS=300
SESSION_ABSOLUTE_HOURS=12
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_ISSUE_LIMIT_PER_15_MIN=5
# Number of trusted reverse proxies in front of the app (X-Forwarded-For hops)
TRUSTED_PROXY_HOPS=0
# Set to true behind HTTPS so cookies are marked Secure
COOKIE_SECURE=false

# Staff email domain and directory
STAFF_EMAIL_DOMAIN=altbank.ng
# dev: seeded bank_directory table. Production: load the bank directory export into bank_directory
DIRECTORY_SOURCE=table

# Object storage: local (encrypted files under STORAGE_LOCAL_DIR, DEV ONLY) | s3
# Hosted/serverless deployments (Vercel, Render, Railway, etc.) MUST use s3: the local
# filesystem is read-only or ephemeral and uploads will fail.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/objects
STORAGE_ENCRYPTION_KEY=ZGV2LW9ubHktc3RvcmFnZS1rZXktY2hhbmdlLW1lLTM=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_KMS_KEY_ID=
S3_FORCE_PATH_STYLE=false
# AES256 (default) | aws:kms | none. Use none for providers that reject SSE headers
# (Supabase Storage, Cloudflare R2, some MinIO setups).
S3_SERVER_SIDE_ENCRYPTION=AES256
# S3 credentials come from the standard AWS variables (or an instance role):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Vercel serverless functions reject request bodies larger than 4.5 MB. When the web app
# is hosted on Vercel, keep this at or below 4 MB. Raise it only for Node hosts (Render, etc.).
MAX_UPLOAD_BYTES=4194304
# Malware scanning: none (production passthrough, scanning disabled) | dev (EICAR check, DEV ONLY) | defer
# This project runs without ClamAV: set SCANNER_DRIVER=none on the web app and the worker.
# defer accepts uploads and leaves them in quarantine for the background worker to clear.
SCANNER_DRIVER=dev
# Document retention policy (years after case closure/rejection)
RETENTION_YEARS=10
RETENTION_PURGE_ENABLED=false

# Email: resend | smtp
# OTP codes and notifications are sent directly to the recipient through Resend.
MAIL_DRIVER=resend
# Must be an address on a domain verified in Resend
MAIL_FROM="ARAF Retail Asset Factory <noreply@araf.ng>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Resend (https://resend.com). Used when MAIL_DRIVER=resend
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
# Optional Reply-To address for Resend messages
RESEND_REPLY_TO=
# Closure packs larger than this are sent as an authenticated link instead of attachments
CLOSURE_MAX_ATTACHMENT_BYTES=10485760

# Assessment calculator (src/server/domain/apr). wakeelboost-pricing@2026.1 = ARAF DSR + flat pricing with APR disclosure
APR_CALCULATOR=wakeelboost-pricing@2026.1

# Worker poll interval (ms)
WORKER_POLL_MS=5000

# Offer letters: optional PDF copy of the generated Word letter for in-browser preview.
# soffice = LibreOffice headless (default when /usr/bin/soffice exists) | none
OFFER_PDF_CONVERTER=
SOFFICE_PATH=
# Staff Personal Financing: Microsoft SharePoint storage for completed facility archives
# (Microsoft Graph, app-only client credentials). Leave SHAREPOINT_ENABLED=false until the bank has
# registered an Entra ID application with Sites.Selected access granted to the target site only.
# Set these on the background worker (it uploads); the secret must never be exposed to browsers.
SHAREPOINT_ENABLED=false
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
# Document library (drive) id of the target library, from GET /sites/{site-id}/drives
SHAREPOINT_DRIVE_ID=
SHAREPOINT_ROOT_FOLDER=ARAF Staff Financing

# ---------------------------------------------------------------------------
# Altphones integrations (docs/ALTPHONES.md). Leave disabled until the bank has credentials; the
# dependent actions stay unavailable and nothing is ever treated as passed or paid without them.
# SeedFi Loan Engine — Seed Score (API documentation v2.0, April 2026). Authenticates with the X-API-Key header
# (create the key with SeedFi's /auth/api/v1/keys/create; it is shown once). Use staging until SeedFi signs off go-live.
#   Staging:    https://stg-loan-engine.theseedfi.com
#   Production: https://loanengine.theseedfi.com
SEEDFI_ENABLED=false
SEEDFI_BASE_URL=https://stg-loan-engine.theseedfi.com
SEEDFI_API_KEY=
SEEDFI_ASSESS_PATH=/scoring/api/v1/seed-score/calculate
SEEDFI_TIMEOUT_MS=30000
# Paystack: secret key (sk_live_... / sk_test_...). Webhook URL: <APP_URL>/api/altphones/paystack/webhook
PAYSTACK_ENABLED=false
PAYSTACK_SECRET_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Enable only after Paystack confirms Direct Debit is active on the bank's integration.
PAYSTACK_DIRECT_DEBIT_ENABLED=false
# true only with a test key (sk_test_...): lists Paystack's Test Bank (001) for account lookups.
PAYSTACK_TEST_MODE=false
PAYSTACK_TIMEOUT_MS=15000
ALTPHONES_OTP_TTL_SECONDS=600
ALTPHONES_OTP_MAX_ATTEMPTS=5

# --- Incidents (technical failures) -----------------------------------------
# Failures with the same fingerprint within this window join one incident.
INCIDENT_CORRELATION_MINUTES=30
# Comma-separated mailbox(es) that receive incident alerts (new incident and severity rises only).
# Leave empty to record incidents without routing them; users then see "Issue detected".
INCIDENT_ALERT_EMAILS=
INCIDENT_ALERTS_PER_HOUR=20
