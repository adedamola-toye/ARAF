# ---------------------------------------------------------------------------
# STAGING environment template (pre-live test environment).
# Copy to .env.staging, fill the placeholders, then run CLI scripts with:
#   ENV_FILE=.env.staging npm run migrate
#   APP_ENV=development ENV_FILE=.env.staging npm run seed -- --with-demo
# .env.staging is gitignored. Never commit real secrets.
# See docs/STAGING.md for the full runbook.
# ---------------------------------------------------------------------------

# staging runs the production guards on purpose
APP_ENV=production
APP_URL=https://REPLACE-WITH-STAGING-VERCEL-URL

# Supabase staging project: liguqkszlrdpddrkylxo
# Use the SHARED SESSION POOLER (IPv4) for laptop/Render commands:
#   postgresql://postgres.liguqkszlrdpddrkylxo:<password>@<pooler-host>:5432/postgres?uselibpqcompat=true&sslmode=require
# Copy <pooler-host> from Supabase: Connect -> Session pooler.
# The direct host db.<ref>.supabase.co is IPv6-only and Render/Vercel cannot reach it.
DATABASE_URL=postgresql://postgres.liguqkszlrdpddrkylxo:REPLACE_WITH_PASSWORD@REPLACE_WITH_POOLER_HOST:5432/postgres?uselibpqcompat=true&sslmode=require

# Generate FRESH staging keys (never reuse production values):
#   openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
APP_HMAC_KEY=
STORAGE_ENCRYPTION_KEY=

# Sessions / OTP
SESSION_IDLE_SECONDS=300
SESSION_ABSOLUTE_HOURS=12
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_ISSUE_LIMIT_PER_15_MIN=5
TRUSTED_PROXY_HOPS=1
COOKIE_SECURE=true

STAFF_EMAIL_DOMAIN=altbank.ng
DIRECTORY_SOURCE=table

# Object storage (Supabase staging bucket: araf-documents-staging)
STORAGE_DRIVER=s3
STORAGE_LOCAL_DIR=.data/objects
S3_BUCKET=araf-documents-staging
S3_REGION=eu-west-1
S3_ENDPOINT=https://liguqkszlrdpddrkylxo.storage.supabase.co/storage/v1/s3
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=none
AWS_ACCESS_KEY_ID=REPLACE_WITH_STAGING_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_STAGING_SECRET_ACCESS_KEY

MAX_UPLOAD_BYTES=4194304
SCANNER_DRIVER=none
RETENTION_YEARS=10
RETENTION_PURGE_ENABLED=false

# Email (staging key and sender)
MAIL_DRIVER=resend
MAIL_FROM="ARAF Retail Asset Factory (Staging) <noreply@araf.ng>"
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
RESEND_REPLY_TO=
CLOSURE_MAX_ATTACHMENT_BYTES=10485760

APR_CALCULATOR=wakeelboost-pricing@2026.1
WORKER_POLL_MS=5000
OFFER_PDF_CONVERTER=none
SOFFICE_PATH=
